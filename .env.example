# ─────────────────────────────────────────────────────────────────────────────
#  HOMA BRIDGE — local environment
#  Copy this file to `.env` (which is git-ignored) and fill in your own values.
#  `run.sh` loads `.env` automatically.
# ─────────────────────────────────────────────────────────────────────────────

# --- Wine / Python location ------------------------------------------------------
# Wine prefix that contains the MetaTrader 5 terminal and the Windows Python 3.11.
# Set MT5_WINEPREFIX to an empty value to run against a NATIVE python3 that has the
# `MetaTrader5` package installed instead of a Wine one.
MT5_WINEPREFIX=$HOME/.mt5

# Path to the Windows python.exe, relative to $WINEPREFIX/drive_c (or absolute).
MT5_WINE_PYTHON=../Python311/python.exe

# Used only when MT5_WINEPREFIX is empty (native run):
# MT5_PYTHON=python3

# --- MetaTrader 5 terminal -----------------------------------------------------
# Windows-style path to the ALREADY-RUNNING terminal executable.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_INIT_TIMEOUT_MS=15000

# --- Broker / account (informational only — the bridge does NOT log in) --------
MT5_COMPANY=Your Broker LLC
MT5_SERVER=YourBroker-Server01
MT5_LOGIN=00000000
MT5_CURRENCY=USD
